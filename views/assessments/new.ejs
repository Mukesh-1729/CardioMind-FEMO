<div class="row justify-content-center mb-5">
  <div class="col-lg-8">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="fw-bold m-0">Cardiovascular Risk Assessment</h2>
      <% if (typeof patient !== 'undefined' && patient) { %>
        <span class="badge bg-secondary fs-6"><i class="bi bi-person me-1"></i> <%= patient.full_name || patient.name %> (<%= patient.age != null ? patient.age : '--' %> yrs)</span>
      <% } %>
    </div>

    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="alert alert-danger shadow-sm border-0 mb-4">
        <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle me-1"></i> Please fix the following errors:</h6>
        <ul class="mb-0 ps-3">
          <% errors.forEach(err => { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="card shadow border-0">
      <div class="card-body p-4 p-md-5">
        <form id="assessmentForm" action="/assessments" method="POST" class="needs-validation" novalidate>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

          <% if (typeof patients !== 'undefined' && patients && patients.length > 1) { %>
            <div class="mb-4 p-3 bg-dark rounded border border-secondary">
              <label for="patient_id" class="form-label text-light fw-semibold"><i class="bi bi-person-check me-1 text-info"></i> Select Patient</label>
              <select class="form-select bg-dark text-light border-secondary" id="patient_id" name="patient_id" required onchange="window.location.href='/assessments/new?patient_id=' + this.value">
                <% patients.forEach(p => { %>
                  <option value="<%= p.id %>" <%= (typeof patient !== 'undefined' && patient && patient.id == p.id) ? 'selected' : '' %>>
                    <%= p.full_name || p.name %> (Age: <%= p.age != null ? p.age : '--' %>, <%= p.sex || p.gender || 'Unknown' %>)
                  </option>
                <% }) %>
              </select>
            </div>
          <% } else if (typeof patient !== 'undefined' && patient && patient.id) { %>
            <input type="hidden" name="patient_id" value="<%= patient.id %>">
          <% } else { %>
            <input type="hidden" name="patient_id" value="1">
          <% } %>

          <!-- Section 1: Vital Signs -->
          <h5 class="text-info fw-bold mb-3 border-bottom border-secondary pb-2"><i class="bi bi-activity me-2"></i>Vital Signs</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label for="systolic_bp" class="form-label text-muted">Systolic BP (mmHg)</label>
              <input type="number" class="form-control bg-dark text-light border-secondary" id="systolic_bp" name="systolic_bp" required min="70" max="250">
              <div class="invalid-feedback">Please enter a valid systolic BP.</div>
            </div>
            <div class="col-md-4">
              <label for="diastolic_bp" class="form-label text-muted">Diastolic BP (mmHg)</label>
              <input type="number" class="form-control bg-dark text-light border-secondary" id="diastolic_bp" name="diastolic_bp" required min="40" max="150">
              <div class="invalid-feedback">Please enter a valid diastolic BP.</div>
            </div>
            <div class="col-md-4">
              <label for="heart_rate" class="form-label text-muted">Heart Rate (bpm)</label>
              <input type="number" class="form-control bg-dark text-light border-secondary" id="heart_rate" name="heart_rate" required min="30" max="220">
            </div>
            <div class="col-md-4">
              <label for="pulse_pressure" class="form-label text-muted">Pulse Pressure <small>(Auto)</small></label>
              <input type="text" class="form-control bg-secondary bg-opacity-25 text-light border-secondary" id="pulse_pressure" readonly>
            </div>
          </div>

          <!-- Section 2: Lab Values -->
          <h5 class="text-info fw-bold mb-3 border-bottom border-secondary pb-2"><i class="bi bi-droplet me-2"></i>Lab Values</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="cholesterol" class="form-label text-muted">Total Cholesterol (mg/dL)</label>
              <input type="number" class="form-control bg-dark text-light border-secondary" id="cholesterol" name="cholesterol" required min="50" max="600">
            </div>
            <div class="col-md-6">
              <label for="glucose" class="form-label text-muted">Fasting Glucose (mg/dL)</label>
              <input type="number" class="form-control bg-dark text-light border-secondary" id="glucose" name="glucose" required min="40" max="500">
            </div>
          </div>

          <!-- Section 3: Body Measurements -->
          <h5 class="text-info fw-bold mb-3 border-bottom border-secondary pb-2"><i class="bi bi-person-bounding-box me-2"></i>Body Measurements</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label for="weight" class="form-label text-muted">Weight (kg)</label>
              <input type="number" step="0.1" class="form-control bg-dark text-light border-secondary" id="weight" name="weight" required min="20" max="300">
            </div>
            <div class="col-md-4">
              <label for="height" class="form-label text-muted">Height (cm)</label>
              <input type="number" class="form-control bg-dark text-light border-secondary" id="height" name="height" required min="50" max="300">
            </div>
            <div class="col-md-4">
              <label for="bmi" class="form-label text-muted">BMI <small>(Auto)</small></label>
              <input type="text" class="form-control bg-secondary bg-opacity-25 text-light border-secondary" id="bmi" name="bmi" readonly>
            </div>
          </div>

          <!-- Section 4: Lifestyle -->
          <h5 class="text-info fw-bold mb-3 border-bottom border-secondary pb-2"><i class="bi bi-cup-hot me-2"></i>Lifestyle</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="smoking_status" class="form-label text-muted">Smoking Status</label>
              <select class="form-select bg-dark text-light border-secondary" id="smoking_status" name="smoking_status" required>
                <option value="" selected disabled>Select...</option>
                <option value="Never">Never Smoked</option>
                <option value="Former">Former Smoker</option>
                <option value="Current">Current Smoker</option>
              </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
              <div class="form-check form-switch mb-2 me-4">
                <input class="form-check-input" type="checkbox" role="switch" id="alcohol_use" name="alcohol_use">
                <label class="form-check-label text-light" for="alcohol_use">Regular Alcohol Use</label>
              </div>
              <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" id="physical_activity" name="physical_activity">
                <label class="form-check-label text-light" for="physical_activity">Regular Physical Activity</label>
              </div>
            </div>
          </div>

          <!-- Section 5: Medical History -->
          <h5 class="text-info fw-bold mb-3 border-bottom border-secondary pb-2"><i class="bi bi-journal-medical me-2"></i>Medical History</h5>
          <div class="row g-3 mb-5">
            <div class="col-md-6">
              <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" id="diabetes" name="diabetes">
                <label class="form-check-label text-light" for="diabetes">Diagnosed Diabetes</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" id="family_history" name="family_history">
                <label class="form-check-label text-light" for="family_history">Family History of CVD</label>
              </div>
            </div>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" id="submitBtn" class="btn btn-primary btn-lg shadow-sm">
              <i class="bi bi-cpu me-2"></i> Run Cardiovascular Risk Assessment
            </button>
          </div>
          
          <div class="text-center mt-4">
            <p class="text-muted small mb-0"><i class="bi bi-shield-lock me-1"></i> Research prototype. Not for clinical use.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
