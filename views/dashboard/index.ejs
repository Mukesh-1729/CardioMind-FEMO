        <div class="metric-grid">
          <div class="metric-tile"><span>ML</span><strong>FastAPI</strong></div>
          <div class="metric-tile"><span>Federation</span><strong>Flower + FedAvg</strong></div>
          <div class="metric-tile"><span>Storage</span><strong>MySQL</strong></div>
          <div class="metric-tile"><span>UI</span><strong>Bootstrap 5 + EJS</strong></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="row g-4">
  <div class="col-lg-7">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 mb-0">Risk distribution</h2>
          <span class="text-muted small">Demo visualization</span>
        </div>
        <canvas id="riskChart" height="220"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body">
