<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? `${title} | CardioMind` : 'CardioMind' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/public/css/main.css" rel="stylesheet">
  <link href="/public/css/dashboard.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>
  
  <div class="app-wrapper">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <aside class="sidebar">
        <ul class="sidebar-nav">
          <% const role = (currentUser.role || '').toUpperCase(); %>
          <% if (role === 'DOCTOR' || role === 'ADMIN') { %>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && (currentPath === '/doctor/dashboard' || currentPath === '/') ? 'active' : '' %>">
              <a href="/"><i class="bi bi-grid-1x2"></i> Dashboard</a>
            </li>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/patients') ? 'active' : '' %>">
              <a href="/patients"><i class="bi bi-people"></i> Patients</a>
            </li>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/assessments') ? 'active' : '' %>">
              <a href="/assessments/new"><i class="bi bi-clipboard2-pulse"></i> Assessments</a>
            </li>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/research') ? 'active' : '' %>">
              <a href="/research/dashboard"><i class="bi bi-speedometer2"></i> Research</a>
            </li>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/hospital') ? 'active' : '' %>">
              <a href="/hospital/dashboard"><i class="bi bi-hospital"></i> Hospital Network</a>
            </li>
          <% } else if (role === 'PATIENT') { %>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath === '/patient/dashboard' ? 'active' : '' %>">
              <a href="/patient/dashboard"><i class="bi bi-house-heart"></i> My Dashboard</a>
            </li>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath === '/patient/history' ? 'active' : '' %>">
              <a href="/patient/history"><i class="bi bi-clock-history"></i> My History</a>
            </li>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath === '/patient/recommendations' ? 'active' : '' %>">
              <a href="/patient/recommendations"><i class="bi bi-list-check"></i> My Recommendations</a>
            </li>
          <% } else if (role === 'RESEARCHER') { %>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath === '/research/dashboard' ? 'active' : '' %>">
              <a href="/research/dashboard"><i class="bi bi-speedometer2"></i> Research Dashboard</a>
            </li>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath === '/research/models' ? 'active' : '' %>">
              <a href="/research/models"><i class="bi bi-cpu"></i> Models</a>
            </li>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath === '/research/experiments' ? 'active' : '' %>">
              <a href="/research/experiments"><i class="bi bi-flask"></i> Experiments</a>
            </li>
          <% } else if (role === 'HOSPITAL') { %>
            <li class="sidebar-item <%= typeof currentPath !== 'undefined' && currentPath === '/hospital/dashboard' ? 'active' : '' %>">
              <a href="/hospital/dashboard"><i class="bi bi-hospital"></i> Hospital Dashboard</a>
            </li>
          <% } %>
        </ul>
      </aside>
    <% } %>

    <main class="main-content">
      <div class="container-fluid">
        <% if (typeof flash !== 'undefined') { %>
          <% if (flash.error && flash.error.length) { %>
            <div class="alert alert-danger shadow-sm border-0"><%= flash.error[0] %></div>
          <% } %>
          <% if (flash.success && flash.success.length) { %>
            <div class="alert alert-success shadow-sm border-0"><%= flash.success[0] %></div>
          <% } %>
        <% } %>
        
        <%- typeof body !== 'undefined' ? body : '' %>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/plotly.js-dist-min@2.35.2/plotly.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/dashboard.js"></script>
  <script src="/public/js/charts/risk-charts.js"></script>
  <script src="/public/js/charts/federated-charts.js"></script>
  <script src="/public/js/charts/research-charts.js"></script>
  <script src="/public/js/assessment.js"></script>
</body>
</html>
