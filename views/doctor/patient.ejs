<% 
  const p = typeof patient !== 'undefined' ? patient : {
    name: 'Unknown Patient', age: '--', gender: '--', mrn: '--',
    apcrs: '--', risk_class: 'Unknown', trend: 'none'
  };
%>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <a href="/patients" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Back to Patients</a>
    <h2 class="fw-bold m-0 mt-1"><%= p.name %> <span class="badge bg-secondary ms-2 fs-6"><%= p.mrn %></span></h2>
  </div>
  <a href="/assessments/new?patient_id=<%= p.id %>" class="btn btn-info shadow-sm"><i class="bi bi-clipboard2-pulse me-1"></i> Run New Assessment</a>
</div>

<div class="row g-4 mb-4">
  <!-- Demographics Card -->
  <div class="col-md-4">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-header border-bottom border-secondary pt-3 pb-2">
        <h5 class="card-title fw-bold m-0">Patient Demographics</h5>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush bg-transparent">
          <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
            <span class="text-muted">Age</span> <strong><%= p.age %> years</strong>
          </li>
          <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
            <span class="text-muted">Gender</span> <strong><%= p.gender %></strong>
          </li>
          <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
            <span class="text-muted">Contact</span> <strong><%= p.contact || '--' %></strong>
          </li>
          <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between border-0">
            <span class="text-muted">Primary Provider</span> <strong><%= p.provider || '--' %></strong>
          </li>
        </ul>
      </div>
    </div>
  </div>
  
  <!-- APCRS Card -->
  <div class="col-md-4">
    <%- include('../partials/apcrs_card', { score: p.apcrs, risk: p.risk_class, trend: p.trend, isPatient: false }) %>
  </div>
  
  <!-- Risk History Chart -->
  <div class="col-md-4">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-header border-bottom border-secondary pt-3 pb-2">
        <h5 class="card-title fw-bold m-0">30-Day Risk History</h5>
      </div>
      <div class="card-body">
        <div class="chart-container" style="height: 180px;">
          <canvas id="riskHistoryChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Clinical Record Summary -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-header border-bottom border-secondary pt-3 pb-2">
        <h5 class="card-title fw-bold m-0">Latest Clinical Values</h5>
      </div>
      <div class="card-body p-0">
        <table class="table table-dark table-striped mb-0">
          <tbody>
            <tr><td>Blood Pressure (Systolic)</td><td class="text-end fw-bold"><%= p.systolic_bp || '--' %> mmHg</td></tr>
            <tr><td>Blood Pressure (Diastolic)</td><td class="text-end fw-bold"><%= p.diastolic_bp || '--' %> mmHg</td></tr>
            <tr><td>Total Cholesterol</td><td class="text-end fw-bold"><%= p.cholesterol || '--' %> mg/dL</td></tr>
            <tr><td>Blood Glucose</td><td class="text-end fw-bold"><%= p.glucose || '--' %> mg/dL</td></tr>
            <tr><td>BMI</td><td class="text-end fw-bold"><%= p.bmi || '--' %></td></tr>
            <tr><td>Smoking Status</td><td class="text-end fw-bold"><%= p.smoking || '--' %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- SHAP Feature Attribution -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-header border-bottom border-secondary pt-3 pb-2">
        <h5 class="card-title fw-bold m-0">Key Risk Factors (SHAP)</h5>
      </div>
      <div class="card-body">
        <div class="chart-container" style="height: 220px;">
          <canvas id="shapChart"></canvas>
        </div>
        <p class="small text-muted mt-2 mb-0 text-center">
          <span class="badge bg-info bg-opacity-25 text-info me-2">Increases Risk</span>
          <span class="badge bg-primary bg-opacity-25 text-primary">Decreases Risk</span>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Recommendations -->
<div class="card mb-4 shadow-sm border-0">
  <div class="card-header border-bottom border-secondary pt-3 pb-2">
    <h5 class="card-title fw-bold m-0">Clinical Recommendations</h5>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <% if (typeof recommendations !== 'undefined' && recommendations.length > 0) { %>
        <% recommendations.forEach(rec => { %>
          <div class="col-md-6">
            <div class="card bg-dark border-secondary h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h6 class="fw-bold m-0 text-light"><i class="bi <%= rec.icon || 'bi-info-circle' %> me-2 text-info"></i> <%= rec.category %></h6>
                  <% if (rec.priority === 'High') { %> <span class="badge bg-danger">High Priority</span>
                  <% } else if (rec.priority === 'Medium') { %> <span class="badge bg-warning text-dark">Medium Priority</span>
                  <% } else { %> <span class="badge bg-success">Routine</span> <% } %>
                </div>
                <p class="text-muted small mb-2"><%= rec.reason %></p>
                <div class="p-2 rounded bg-secondary bg-opacity-25 border border-secondary text-light small">
                  <strong>Suggested Action:</strong> <%= rec.action %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center text-muted py-3">No specific recommendations available.</div>
      <% } %>
    </div>
    <div class="disclaimer-box mt-4">
      <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
      <strong>Disclaimer:</strong> This is a research prototype. These automated recommendations are generated by the CardioMind-FEMO model and should not override clinical judgment.
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof RiskCharts !== 'undefined') {
      const histLabels = <%- JSON.stringify(typeof history !== 'undefined' ? history.labels : ['Oct 1', 'Oct 8', 'Oct 15', 'Oct 22', 'Oct 29']) %>;
      const histValues = <%- JSON.stringify(typeof history !== 'undefined' ? history.values : [15, 14, 18, 17, 16]) %>;
      RiskCharts.renderRiskHistory('riskHistoryChart', histLabels, histValues);

      const shapFeatures = <%- JSON.stringify(typeof shap !== 'undefined' ? shap.features : ['Systolic BP', 'Age', 'Cholesterol', 'Smoking', 'BMI']) %>;
      const shapValues = <%- JSON.stringify(typeof shap !== 'undefined' ? shap.values : [0.15, 0.12, 0.08, -0.05, 0.02]) %>;
      RiskCharts.renderSHAPBars('shapChart', shapFeatures, shapValues);
    }
  });
</script>
