<div class="mb-4">
  <h2 class="fw-bold text-light">My Heart Health History</h2>
  <p class="text-muted">Track your progress over time.</p>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body p-4 p-md-5 text-center bg-dark">
    <h4 class="text-info mb-3">Understanding Your Score</h4>
    <p class="text-muted mb-0" style="max-width: 700px; margin: 0 auto;">
      Your score goes up when risk factors like blood pressure or cholesterol increase. 
      It goes down when you make healthy lifestyle choices. Tracking your score over time 
      shows you how your heart health is changing.
    </p>
  </div>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-header border-bottom border-secondary pt-4 pb-3 px-4">
    <h5 class="card-title fw-bold m-0"><i class="bi bi-graph-up text-info me-2"></i> Score Trend</h5>
  </div>
  <div class="card-body p-4">
    <div class="chart-container" style="height: 300px;">
      <canvas id="fullHistoryChart"></canvas>
    </div>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header border-bottom border-secondary pt-4 pb-3 px-4">
    <h5 class="card-title fw-bold m-0"><i class="bi bi-calendar3 text-info me-2"></i> Past Assessments</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-dark table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th class="ps-4 py-3">Date</th>
            <th class="py-3">Score</th>
            <th class="py-3">Risk Level</th>
            <th class="py-3">Trend</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof records !== 'undefined' && records.length > 0) { %>
            <% records.forEach(record => { %>
              <tr>
                <td class="ps-4"><%= record.date %></td>
                <td class="fw-bold"><%= record.score %></td>
                <td><%- include('../partials/risk_badge', { risk: record.risk }) %></td>
                <td>
                  <% if (record.trend === 'up') { %> <span class="text-danger"><i class="bi bi-arrow-up me-1"></i> Increased</span>
                  <% } else if (record.trend === 'down') { %> <span class="text-success"><i class="bi bi-arrow-down me-1"></i> Improved</span>
                  <% } else { %> <span class="text-secondary"><i class="bi bi-dash me-1"></i> Stable</span> <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td class="ps-4">Today</td>
              <td class="fw-bold">8</td>
              <td><span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> Low</span></td>
              <td><span class="text-secondary"><i class="bi bi-dash me-1"></i> Stable</span></td>
            </tr>
            <tr>
              <td class="ps-4">May 15, 2026</td>
              <td class="fw-bold">9</td>
              <td><span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> Low</span></td>
              <td><span class="text-success"><i class="bi bi-arrow-down me-1"></i> Improved</span></td>
            </tr>
            <tr>
              <td class="ps-4">Jan 10, 2026</td>
              <td class="fw-bold">11</td>
              <td><span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-exclamation-triangle me-1"></i> Moderate</span></td>
              <td><span class="text-secondary"><i class="bi bi-dash me-1"></i> Stable</span></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof RiskCharts !== 'undefined') {
      const histLabels = <%- JSON.stringify(typeof fullHistory !== 'undefined' ? fullHistory.labels : ['Jan 2026', 'Feb 2026', 'Mar 2026', 'Apr 2026', 'May 2026', 'Jun 2026', 'Jul 2026', 'Aug 2026']) %>;
      const histValues = <%- JSON.stringify(typeof fullHistory !== 'undefined' ? fullHistory.values : [11, 10, 10, 11, 9, 8, 8, 8]) %>;
      RiskCharts.renderRiskHistory('fullHistoryChart', histLabels, histValues);
    }
  });
</script>
